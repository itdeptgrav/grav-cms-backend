+# GET /snapshot/<i>?quality=original: ONE live main-stream picture for an occasional
+# detail scan (e.g. the factory twin's object detector), instead of a continuous Original
+# stream. It counts as a grid viewer while it waits (never pinned, so no fullscreen
+# priority) and is encoded no wider than ORIGINAL_GRID_MAX_W like a grid tile. The main
+# stream is opened for it and released ORIGINAL_SNAPSHOT_LINGER_S after (default: the
+# normal Original linger), so callers that ask every few seconds can choose between
+# keeping it warm (linger > interval) and opening it each time. Never a Standard picture
+# in its place: if no live Original frame arrives within ORIGINAL_SNAPSHOT_WAIT_S the
+# answer is 503.
+ORIGINAL_SNAPSHOT_WAIT_S   = _envfloat("CCTV_ORIGINAL_SNAPSHOT_WAIT_S", 10.0)
