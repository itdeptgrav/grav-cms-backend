+def _get(port, path):
+    import http.client
+    c = http.client.HTTPConnection("127.0.0.1", port, timeout=20)
+    c.request("GET", path)
+    r = c.getresponse()
+    out = (r.status, dict(r.getheaders()), r.read())
+    c.close()
+    return out
+
+
+def test_original_snapshot_is_one_live_main_stream_picture(port):
+    i = NVR1[-1]
+    key = f"key={server.TOKEN}&" if server.TOKEN else ""
+    wait(lambda: O[i].viewers == 0 and not O[i]._running, 3.0)
+    status, headers, body = _get(port, f"/snapshot/{i}?{key}quality=original")
+    check("/snapshot/<i>?quality=original -> one LIVE main-stream picture at grid size (1280 wide), JPEG 90",
+          status == 200 and body == b"jpeg-1280x720-q90" and headers.get("X-Frame-State") == "live"
+          and headers.get("X-Frame-Size") == "1280x720", (status, body[:40], headers.get("X-Frame-Size")))
+    check("... it opened the MAIN stream", OPENS.get((i, 0), 0) >= 1, OPENS.get((i, 0)))
+    check("... and held no viewer afterwards (never pinned, nothing left behind)",
+          O[i].viewers == 0 and O[i].viewers_full == 0, (O[i].viewers, O[i].viewers_full))
+    check("... the main stream is released after the linger", wait(lambda: not O[i]._running, 3.0), O[i].bg_reason)
+    status, _, body = _get(port, f"/snapshot/{i}?{key[:-1]}" if key else f"/snapshot/{i}")
+    check("plain /snapshot/<i> is still the Standard picture", status == 200 and body == b"jpeg-640x360-q70", body[:40])
+    FAIL.add((i, 0))
+    try:
+        status, headers, body = _get(port, f"/snapshot/{i}?{key}quality=original")
+        check("main stream failing -> 503, never a Standard picture passed off as Original",
+              status == 503 and not body.startswith(b"jpeg-") and headers.get("Retry-After") == "10", (status, body[:40]))
+    finally:
+        FAIL.discard((i, 0))
+    check("slot table consistent, cap respected", consistent())
+
+
