# deploy/metabase-pilot/.env.example
#
# Copy to `.env` and replace every value. `.env` is git-ignored.
#
# PLACEHOLDERS ONLY — never commit a real value, and never reuse a password,
# secret or token from any GRAV environment here. Nothing in this pilot touches
# real data, so nothing in it needs a real credential.
#
# There are FOUR credentials below: three database passwords and the local
# Metabase admin password. The admin email is not a credential and can stay as
# it is — `.invalid` is a TLD guaranteed never to resolve.
#
#   cp .env.example .env
#   # then generate four distinct values, e.g.
#   #   openssl rand -hex 24

PILOT_APP_DB_PASSWORD=replace-me-app-db
PILOT_REPORTING_OWNER_PASSWORD=replace-me-reporting-owner
PILOT_REPORTING_READONLY_PASSWORD=replace-me-reporting-readonly

# Used by `./bootstrap.sh` to provision the local Metabase admin, and by
# verify.sh to sign in. Local evaluation only; never a real address or password.
# The password must satisfy Metabase's complexity rules (letters, digit, symbol).
PILOT_METABASE_ADMIN_EMAIL=pilot-admin@example.invalid
PILOT_METABASE_ADMIN_PASSWORD=replace-me-metabase-admin
