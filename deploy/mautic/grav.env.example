# deploy/mautic/grav.env.example
#
# The GRAV-side settings for the Mautic integration. These belong in the GRAV
# backend's own untracked `.env`, NOT in `deploy/mautic/.env` — they are
# GRAV's credentials for calling Mautic, not Mautic's own configuration.
#
# Named `grav.env.example` rather than `.env.something` deliberately: this
# repository's `.gitignore` refuses every path matching `.env.*` (a rule added
# after a hand-made env backup was committed with live credentials), and a file
# that silently fails to be committed is worse than one with an awkward name.
#
# NAMES ONLY. No value below is a secret.

# ── WHERE MAUTIC IS ────────────────────────────────────────────────────────
# No trailing slash. The adapter appends "/api/...".
MAUTIC_BASE_URL=http://localhost:8088

# ── HOW GRAV AUTHENTICATES ─────────────────────────────────────────────────
# "oauth2" (preferred) or "basic". Anything else is refused at start-up rather
# than defaulted, because a mistyped scheme that silently falls back to the
# weaker one is a downgrade nobody sees.
MAUTIC_AUTH_MODE=oauth2

# OAuth2 client_credentials, from Mautic → Settings → API Credentials.
MAUTIC_OAUTH_CLIENT_ID=
MAUTIC_OAUTH_CLIENT_SECRET=

# Basic auth, for a development instance where OAuth is not yet configured.
# The username of the LEAST-PRIVILEGE integration user (README.md), never the
# administrator's.
MAUTIC_BASIC_USERNAME=
MAUTIC_BASIC_PASSWORD=

# ── WEBHOOKS ───────────────────────────────────────────────────────────────
# The secret typed into the Mautic webhook's own "Secret" field. Mautic signs
# each delivery with it as base64(HMAC-SHA256(rawBody, secret)) in the
# `Webhook-Signature` header. With this unset, GRAV rejects every webhook —
# a verification that passes when unconfigured is not a verification.
MAUTIC_WEBHOOK_SECRET=

# ── WHICH COMPANY MAUTIC'S EVENTS BELONG TO ────────────────────────────────
# One Mautic instance serves one GRAV organisation (ADR-004). The company is
# deployment configuration, not something a webhook sender may assert.
MARKETING_COMPANY_ID=

# ── THE TEST SEGMENT USED BY THE ROUND-TRIP PROOF ──────────────────────────
# Mautic's numeric segment id, or its alias. Chunk 0's proof enrols one
# synthetic person into it.
MAUTIC_TEST_SEGMENT=grav-integration-test

# ── WHICH AUTOMATION IS ACQUISITION ────────────────────────────────────────
# THE ACQUISITION CLASSIFICATION CONTRACT. When Sales accepts a Prospect, GRAV
# stops acquisition marketing for that ONE person by removing them from the
# segments and campaigns listed here, and by adding a standing
# `grav_acquisition_hold != 1` filter to each listed segment so they are not
# enrolled again later.
#
# Comma-separated Mautic segment/campaign ids or aliases. GRAV resolves every
# entry against the live instance before it touches anything.
#
# LEAVING THESE EMPTY DOES NOT MEAN "EVERYTHING". It means GRAV refuses the
# stop, removes no membership and writes no `acquisitionPausedAt`, reporting
# ACQUISITION_SCOPE_MISSING. That is deliberate: transactional, service,
# post-sale and approved Sales-assisted nurture automation run in this same
# instance, and an acceptance that guessed would tear the person out of their
# order confirmations and service reminders too.
#
# Only list paths GRAV may remove an accepted Prospect from. A registered
# acquisition CAMPAIGN must draw its contacts only from registered acquisition
# SEGMENTS, or GRAV refuses with ACQUISITION_SCOPE_UNVERIFIABLE rather than
# leave a hole through which a held person is re-enrolled.
MAUTIC_ACQUISITION_SEGMENTS=
MAUTIC_ACQUISITION_CAMPAIGNS=

# ── OPERATIONAL LIMITS ─────────────────────────────────────────────────────
MAUTIC_HTTP_TIMEOUT_MS=10000
MAUTIC_HTTP_RETRIES=2
MAUTIC_WEBHOOK_MAX_PER_MINUTE=300

# ── DISCOVERY (Zintlr or any other provider) ───────────────────────────────
# Named here only to state the boundary: a discovery provider is called by
# GRAV, never by Mautic, and never appears in the Mautic stack's own env file.
MARKETING_DISCOVERY_PROVIDER=
