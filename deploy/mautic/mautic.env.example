# deploy/mautic/mautic.env.example
#
# The Mautic development stack's own settings. Copy to `deploy/mautic/.env`,
# fill in real values, and never commit that file — `.gitignore` refuses it.
#
# NAMES ONLY BELOW. Every value here is either a placeholder that is obviously
# not a secret, or empty. A "example" file with a working password in it is how
# a development credential reaches production, and this repository has already
# had one credential leak through a hand-made env backup (see .gitignore).
#
# Generate each password with something you did not choose yourself:
#   openssl rand -base64 30

# ── MariaDB (Mautic's database; GRAV never connects to it) ─────────────────
MAUTIC_DB_ROOT_PASSWORD=
MAUTIC_DB_NAME=mautic
MAUTIC_DB_USER=mautic
MAUTIC_DB_PASSWORD=

# ── Mautic ─────────────────────────────────────────────────────────────────
# The base URL Mautic believes it is served at. It must match what GRAV calls,
# or Mautic's generated links and its OAuth redirect will disagree with it.
MAUTIC_BASE_URL=http://localhost:8088
MAUTIC_HTTP_PORT=8088

# The FIRST administrator, created once at install. This account is for setting
# the instance up. It is NOT the account GRAV authenticates as — see the
# least-privilege integration identity in README.md.
MAUTIC_ADMIN_USERNAME=admin
MAUTIC_ADMIN_EMAIL=
MAUTIC_ADMIN_PASSWORD=

# ── Mail sink ──────────────────────────────────────────────────────────────
# Mailpit's web UI. SMTP itself is reachable only on the internal network.
MAILSINK_UI_PORT=8025
