# LiveKit Cloud project used by the CMS token/dispatch service.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
MRF_VOICE_AGENT_NAME=grav-mrf-approval
MRF_VOICE_LANGUAGES=en
MRF_VOICE_WORKER_HEALTH_PORT=8091
MRF_VOICE_IDLE_PROCESSES=1
MRF_VOICE_VAD_MIN_SPEECH=0.25
MRF_VOICE_VAD_MIN_SILENCE=0.45
MRF_VOICE_VAD_PREFIX_PADDING=0.30
MRF_VOICE_VAD_ACTIVATION=0.65
MRF_VOICE_VAD_DEACTIVATION=0.45

# Public HTTPS address of grav-cms-backend. The worker endpoint is authenticated.
GRAV_BACKEND_URL=https://api.example.com
MRF_VOICE_WORKER_SECRET=

# Local, pod-private OpenAI-compatible speech gateway.
GRAV_SPEECH_GATEWAY_URL=http://127.0.0.1:8890/v1
GRAV_SPEECH_GATEWAY_KEY=local-only
GRAV_SPEECH_CACHE_DIR=/workspace/grav-mrf-voice/cache/tts
GRAV_HINDI_GATEWAY_URL=http://127.0.0.1:8894
GRAV_HINDI_CHATTERBOX_SOURCE=ResembleAI/Chatterbox-Multilingual-TTS-hi
GRAV_HINDI_CHATTERBOX_REFERENCE_URL=https://storage.googleapis.com/chatterbox-demo-samples/mtl_prompts/hi_f1.flac
GRAV_HINDI_CHATTERBOX_REFERENCE_PATH=/workspace/grav-mrf-voice/cache/chatterbox/hi_f1.flac
GRAV_TRANSLATION_GATEWAY_URL=http://127.0.0.1:8893/v1
GRAV_TRANSLATION_GATEWAY_KEY=local-only
GRAV_TRANSLATION_MODEL=naklitechie/indictrans2-en-indic-dist-200M-ONNX
GRAV_DIALOG_GATEWAY_URL=http://127.0.0.1:8891/v1
GRAV_DIALOG_GATEWAY_KEY=local-only
MRF_DIALOG_MODEL=Qwen/Qwen3-4B-Instruct-2507
MRF_DIALOG_4BIT=true
MRF_DIALOG_PRELOAD=true
MRF_DIALOG_DEADLINE_SECONDS=1.5

# Models are cached on RunPod persistent storage, never on the CMS host.
HF_HOME=/workspace/grav-mrf-voice/cache/huggingface
GRAV_SPEECH_APP_ROOT=/workspace/grav-speech/app
GRAV_SPEECH_MODEL_DIR=/workspace/grav-speech/models/indic-transcribe-flex
GRAV_SPEECH_DIARIZER_PATH=/workspace/grav-speech/models/diar_sortformer_4spk-v1.nemo
GRAV_TTS_DEVICE=cuda
INDICF5_REFERENCE_HI=
INDICF5_REFERENCE_HI_TEXT=
INDICF5_REFERENCE_OR=
INDICF5_REFERENCE_OR_TEXT=
