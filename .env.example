# Server-only Grav Storage credentials. Do not expose either value to browsers
# or GRAV Studio, and never commit the real values.
GRAV_STORAGE_URL=https://cloud.grav.in
GRAV_STORAGE_API_KEY=

# Separate Studio client credential. It is deliberately not the storage key.
# A future assignment surface binds this credential to one R&D designer.
GRAV_STUDIO_API_KEY=
GRAV_STUDIO_DESIGNER_EMAIL=
